# 当前唯一可运行模式；不会访问真实公司 API 或模型。
PFINDER_AI_RUNTIME_MODE=fake

# 本地 SQLite 调查轨迹和临时仓库目录。
PFINDER_AI_DATABASE_PATH=.pfinder/investigations.sqlite3
PFINDER_AI_WORKSPACE_BASE_DIRECTORY=.pfinder/workspaces

# Pydantic Settings 对复合类型使用 JSON 格式。
PFINDER_AI_TRUSTED_GIT_HOSTS=["git.example.local"]

# Demo 调查边界；生产值需要结合真实用量重新确认。
PFINDER_AI_MAX_DEPTH=4
PFINDER_AI_MAX_PROVIDER_CALLS=20
PFINDER_AI_MAX_ELAPSED_SECONDS=300
PFINDER_AI_TRACE_CANDIDATE_LIMIT=5
PFINDER_AI_LOG_MAX_ENTRIES=200
PFINDER_AI_GRAPH_RECURSION_LIMIT=50

# Codex Adapter 预留配置；Fake CLI 当前不会读取账号或发起真实调用。
PFINDER_AI_CODEX_MODEL=
PFINDER_AI_CODEX_TIMEOUT_SECONDS=300
PFINDER_AI_CODEX_BIN=
